# Interpolated into deploy/compose.yaml for the e2e run only:
#   docker compose --env-file tests/e2e/e2e.env -f deploy/compose.yaml --profile e2e ...
# Test-only values; never reuse them anywhere real.
URIEL_MODELS_FILE=/e2e/models.e2e.yaml
URIEL_TALK_ENABLED=true
URIEL_RUNNER_ENABLED=true
URIEL_TALK_POLL_SECONDS=1
URIEL_RUNNER_SECONDS=2
URIEL_NC_URL=http://fake-talk:9100
URIEL_NC_APP_PASSWORD=e2e-talk-password
URIEL_LDAP_URL=ldap://lldap:3890
URIEL_LDAP_BIND_DN=uid=admin,ou=people,dc=homelab-station,dc=com
URIEL_LDAP_PASSWORD=e2e-ldap-admin-password
URIEL_LDAP_BASE_DN=dc=homelab-station,dc=com
